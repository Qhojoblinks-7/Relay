# Example environment for Relay Cloud Functions (committed, NO secrets).
# Copy this file to `functions/.env` and fill in real values from the
# GetStream dashboard. `functions/.env` is git-ignored — never commit secrets.
#
# GetStream config (params API: defineString)
GETSTREAM_API_KEY=YOUR_GETSTREAM_API_KEY
GETSTREAM_API_SECRET=YOUR_GETSTREAM_API_SECRET
