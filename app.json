{
  "expo": {
    "name": "Relay",
    "slug": "Relay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon-1024.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1C1412",
    "scheme": "relay",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1412"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip",
          "fetch"
        ]
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon-1024.png",
        "backgroundColor": "#1C1412"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "package": "com.immanuel_e.Relay"
    },
    "web": {
      "favicon": "./src/assets/icon-1024.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C1412",
          "image": "./src/assets/icon-1024.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Relay to access your camera for video features",
          "microphonePermission": "Allow Relay to access your microphone for walkie-talkie communication",
          "recordAudioAndroid": true
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Relay to access your camera for video features",
          "microphonePermission": "Allow Relay to access your microphone for walkie-talkie communication"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Relay to access your microphone for walkie-talkie communication"
        }
      ],
      "@stream-io/video-react-native-sdk",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "7ddc4c74-4862-4eb7-b42c-8612a585d552"
      },
      "getstream": {
        "apiKey": "YOUR_GETSTREAM_API_KEY",
        "useDevToken": true,
        "secret": "YOUR_GETSTREAM_SECRET"
      },
      "firebase": {
        "apiKey": "YOUR_FIREBASE_API_KEY",
        "authDomain": "relay-6273b-8832.firebaseapp.com",
        "projectId": "relay-6273b-8832",
        "storageBucket": "relay-6273b-8832.firebasestorage.app",
        "messagingSenderId": "841841612894",
        "appId": "1:841841612894:web:93910d45aa26797869bccf"
      }
    }
  }
}
