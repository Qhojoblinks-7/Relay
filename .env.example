# Environment variables for Relay
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# GetStream API credentials
# Find these in your GetStream dashboard: https://getstream.io/dashboard
EXPO_PUBLIC_GETSTREAM_API_KEY=your_getstream_api_key_here
EXPO_PUBLIC_GETSTREAM_SECRET=your_getstream_secret_here

# Firebase config
# Find these in your Firebase console: https://console.firebase.google.com
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
